<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:allowBackup="true"
        android:label="RecoX"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Recox">
        <activity android:name="com.bcs.RecoX.SplashActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name="com.bcs.RecoX.RecordingService" android:exported="false" />
        <activity android:name="com.bcs.RecoX.SettingsActivity" />
        <activity android:name="com.bcs.RecoX.MainActivity" />
    </application>
</manifest>
